# ─────────────────────────────────────────────────────────────────────────
# Приклад середовища. Скопіювати в .env і заповнити.
#   cp .env.example .env
#
# Жоден справжній .env у репозиторій не потрапляє (.gitignore), а gitleaks
# у pre-commit блокує коміт із секретом у diff.
#
# Валідація — packages/shared/src/env.schema.ts. Процес НЕ стартує з
# некоректним середовищем: помилка конфігурації мусить падати на старті,
# а не в момент першої відправки листа.
# ─────────────────────────────────────────────────────────────────────────

# СЕРВЕРНА змінна, без NEXT_PUBLIC_ (ADR-10): local | staging | production
APP_ENV=local

DATABASE_URL=postgres://store_app:store_app@localhost:54322/store
# Лише для `pnpm db:migrate` (CI / деплой / локально). Роль store_migrate:
# DDL і default privileges для store_app. Застосунок цю змінну НЕ читає —
# web і worker не повинні мати креденшелів, що змінюють схему.
DATABASE_MIGRATE_URL=postgres://store_migrate:store_migrate@localhost:54322/store

# Обов'язковий, коли APP_ENV != production. Перекриває ВСІХ отримувачів,
# щоб стенд не розсилав листи реальним клієнтам. Локально листи ловить
# Mailpit на http://localhost:8025 — нікуди не виходять.
EMAIL_TO_OVERRIDE=dev@example.com
EMAIL_FROM=shop@example.com

# openssl rand -base64 32
AUTH_SECRET=

# ── Платіжки: тестові дані локально, live тільки в production ──────────
MONO_PLATA_TOKEN=
WAYFORPAY_MERCHANT_ACCOUNT=
WAYFORPAY_SECRET_KEY=

# ── Доставка ──────────────────────────────────────────────────────────
NOVA_POSHTA_API_KEY=
UKRPOSHTA_API_KEY=

# ── Email ─────────────────────────────────────────────────────────────
RESEND_API_KEY=

# ── Cloudflare R2 (медіа) ─────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_MEDIA=store-media

# ── Спостережуваність ─────────────────────────────────────────────────
SENTRY_DSN=

# Build-time: вшивається в бандл, тому не може відрізнятися між
# staging і production на одному образі.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Тільки staging: закритий стенд ────────────────────────────────────
# Точні POST-маршрути вебхуків виключаються з basic auth — не префікс /api,
# інакше провайдер отримає 401 і не дійде до перевірки підпису.
STAGING_BASIC_AUTH_USER=
STAGING_BASIC_AUTH_PASSWORD=
STAGING_BASIC_AUTH_EXCLUDE=/api/webhooks/mono,/api/webhooks/wayforpay

# ─────────────────────────────────────────────────────────────────────────
# Тільки для docker-compose (не читаються застосунком)
# ─────────────────────────────────────────────────────────────────────────
POSTGRES_DB=store
POSTGRES_SUPERUSER=store_root
POSTGRES_SUPERUSER_PASSWORD=
POSTGRES_APP_USER=store_app
POSTGRES_APP_PASSWORD=
POSTGRES_MIGRATE_USER=store_migrate
POSTGRES_MIGRATE_PASSWORD=
POSTGRES_BOSS_USER=store_boss
POSTGRES_BOSS_PASSWORD=

# Бекапи (окремий bucket і окремі креденшели: web їх не отримує)
R2_S3_ENDPOINT=
R2_BUCKET_BACKUPS=store-backups
