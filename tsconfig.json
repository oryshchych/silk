{
  // Корінь: лише конфіги й скрипти рівня репозиторію. Код живе в
  // apps/* і packages/*, кожен зі своїм tsconfig.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    // Scripts import each other with the .ts extension so Node can run them directly.
    "allowImportingTsExtensions": true
  },
  "include": ["*.ts", "*.js", "scripts/**/*.ts"],
  "exclude": ["node_modules"]
}
