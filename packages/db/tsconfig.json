{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // migrate.ts запускається Node напряму (type stripping), а Node вимагає
    // розширення у відносних імпортах. noEmit уже ввімкнений у базі.
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "drizzle.config.ts"],
  "exclude": ["node_modules", "dist"]
}
