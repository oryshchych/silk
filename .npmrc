# Версія Node пінується жорстко: невідповідність мусить падати на install,
# а не проявлятися дивною помилкою збірки.
engine-strict=true

# shamefully-hoist НІКОЛИ. Строгий node_modules — це те, що фізично не дає
# packages/core імпортувати next, якщо той не оголошений у його package.json
# (AGENTS.md §7). З hoist це правило знову стає питанням код-рев'ю.
