{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits"],
  "timezone": "Europe/Kyiv",
  "schedule": ["before 6am on monday"],
  "labels": ["dependencies"],
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "description": "Patch dev-залежностей — автомердж після зелених тестів",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch"],
      "groupName": "dev patches",
      "automerge": true
    },
    {
      "description": "Major — завжди окремий PR із changelog",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "automerge": false
    },
    {
      "description": "Node пінується мажором: 24 LTS, не «останній»",
      "matchPackageNames": ["node", "@types/node"],
      "allowedVersions": "<25"
    },
    {
      "description": "TypeScript лишається на 6.x: у 7.0 немає стабільного програмного API, тому typescript-eslint із ним не працює (DEVELOPMENT.md §0)",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7"
    }
  ],
  "vulnerabilityAlerts": { "labels": ["security"], "automerge": false }
}
