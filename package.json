{
  "name": "store",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "docker compose -f docker-compose.local.yml up -d --wait --build && turbo dev",
    "dev:db": "docker compose -f docker-compose.local.yml up -d --wait --build",
    "dev:db:stop": "docker compose -f docker-compose.local.yml down",
    "db:generate": "pnpm --filter @store/db db:generate",
    "db:check": "pnpm --filter @store/db db:check",
    "db:migrate": "pnpm --filter @store/db db:migrate",
    "db:seed": "pnpm --filter @store/db db:seed",
    "build": "turbo build",
    "typecheck": "tsc -p tsconfig.json --noEmit && turbo typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:int": "vitest run --project integration --passWithNoTests",
    "migrate:fresh": "vitest run --project integration packages/db/test/migrate-fresh.int.test.ts",
    "test:coverage": "vitest run --project unit --coverage",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "boundaries": "depcruise packages apps",
    "knip": "knip",
    "secrets": "./scripts/gitleaks.sh detect --redact --no-banner",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@next/eslint-plugin-next": "16.3.8",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-i18next": "6.1.5",
    "knip": "^6.43.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
